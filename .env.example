# Copy this file to `.env` and fill in the values. Anything left as a
# REPLACE_WITH_* placeholder is treated as "not configured" by the app.

# --- AI (required for the chatbot) ---
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_API_KEY

# --- Database (required) ---
MONGO_URI=REPLACE_WITH_YOUR_MONGODB_URI

# --- Observability (optional) ---
# The Logfire SDK looks for LOGFIRE_TOKEN; LOGFIRE_API_KEY is also accepted.
LOGFIRE_API_KEY=REPLACE_WITH_YOUR_LOGFIRE_TOKEN

# --- Google Sign-In (optional — from Google Cloud Console) ---
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID

# --- LLM gateway (optional — https://portkey.ai, free Developer tier) ---
# When set to a real key, Groq calls are routed through Portkey. Left as a
# placeholder, the app calls Groq directly.
PORTKEY_API_KEY=REPLACE_WITH_YOUR_PORTKEY_API_KEY
PORTKEY_GROQ_PROVIDER=groq

# --- Reserved (not currently used by any code path) ---
# TAVILY_API_KEY=REPLACE_WITH_YOUR_TAVILY_API_KEY
