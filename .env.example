# Copy this file to `.env` and fill in the values.

# --- The client's product catalog (read-only) ---
MONGO_URI="YOUR_MONGO_URI"

# --- LLM (required) ---
GROQ_API_KEY="YOUR_GROQ_API_KEY" 

# --- LLM gateway (optional — https://portkey.ai) ---
# When set to a real key, Groq calls are routed through Portkey. Left as a
# placeholder, the app calls Groq directly.
PORTKEY_API_KEY="YOUR_PORTKEY_API_KEY"
PORTKEY_GROQ_PROVIDER=groq

# --- Observability (optional) ---
# LOGFIRE_TOKEN=REPLACE_WITH_YOUR_LOGFIRE_TOKEN
